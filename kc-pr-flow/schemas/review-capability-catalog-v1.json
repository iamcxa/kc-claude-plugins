    "workflow_change": {"path_pattern": "^\\.github/workflows/", "minimum_paths": 1},
    "security_change": {"path_pattern": "(^|/)(auth|security|permissions?|secrets?)(/|\\.)", "minimum_paths": 1},
    "stacked_pr_shape": {"path_pattern": ".", "minimum_paths": 11}
  },
