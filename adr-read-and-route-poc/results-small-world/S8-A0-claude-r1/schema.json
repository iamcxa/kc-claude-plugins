{
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "decision": {
   "type": "string",
   "description": "One or two sentences: what you decided and why."
  },
  "recorded": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "path": {
      "type": "string"
     },
     "info": {
      "type": "string"
     }
    },
    "required": [
     "path",
     "info"
    ]
   }
  },
  "choice": {
   "type": "string",
   "enum": [
    "us-east-1",
    "eu-west-1"
   ]
  },
  "ruling_check": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "adr": {
     "type": "string",
     "description": "ADR number, four digits"
    },
    "commit": {
     "type": "string",
     "description": "full commit id you read the ruling at"
    },
    "digest": {
     "type": "string",
     "description": "sha256:<hex> you computed over the ruling file's bytes"
    },
    "digest_matches_cited": {
     "type": "boolean"
    },
    "in_force": {
     "type": [
      "boolean",
      "null"
     ],
     "description": "null when you could not tell"
    },
    "action": {
     "type": "string",
     "enum": [
      "proceed",
      "stop"
     ]
    }
   },
   "required": [
    "adr",
    "commit",
    "digest",
    "digest_matches_cited",
    "in_force",
    "action"
   ]
  }
 },
 "required": [
  "decision",
  "recorded",
  "choice",
  "ruling_check"
 ]
}