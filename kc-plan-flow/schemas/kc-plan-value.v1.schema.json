{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kc-plan-value/v1",
  "title": "kc-plan-value v1",
  "description": "What to build. Its project block is shaped to lift straight into kc-plan-receipt/v1's project block; every field and bound here is that contract's, not a second opinion about it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "milestones", "issues", "questions_for_the_archaeologist", "needs_a_ruling"],
  "properties": {
    "schema": { "const": "kc-plan-value/v1" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "user_value", "hypothesis", "wedge", "outcome", "exit"],
      "properties": {
        "name": { "type": "string", "maxLength": 80, "minLength": 1 },
        "user_value": { "type": "string", "maxLength": 200, "pattern": "^[^\n]+$" },
        "hypothesis": { "type": "string", "pattern": "^If we .+ then .+$" },
        "wedge": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "exit": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "target", "description", "integration_proof"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "description": { "type": "string", "maxLength": 140, "pattern": "^[^\n]+$" },
          "integration_proof": {
            "type": "object",
            "additionalProperties": false,
            "required": ["proof", "owner"],
            "properties": {
              "proof": { "type": "string", "minLength": 1 },
              "owner": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "acceptance", "milestone", "kind"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "acceptance": { "type": "string", "minLength": 1 },
          "milestone": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["value", "defect", "measurement"] },
          "protects": { "type": "string", "minLength": 1 }
        }
      }
    },
    "questions_for_the_archaeologist": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "needs_a_ruling": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
