{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kc-plan-detail/v1",
  "title": "kc-plan-detail v1",
  "description": "How to build it. Sub-issues cut against archaeology findings, written in the form plan-lint reads, plus the lint result they were judged by.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "value_issue",
    "archaeology",
    "sub_issues",
    "lint"
  ],
  "properties": {
    "schema": {
      "const": "kc-plan-detail/v1"
    },
    "value_issue": {
      "type": "string",
      "minLength": 1
    },
    "archaeology": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "classification",
          "ref",
          "command",
          "evidence"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "WORKING",
              "WORKING_UNIT_UNPROVEN",
              "EXISTS_BROKEN",
              "STUB",
              "MISSING",
              "LOCATED"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "description": "The command that produced the finding. Without it the classification is an opinion."
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "description": "What the command returned, in enough detail to be disagreed with."
          },
          "stratum": {
            "type": "string",
            "minLength": 1,
            "description": "Which ref carries it and that ref's relation to the trunk. A thing on a closed branch is not a thing that exists."
          },
          "absence_proof": {
            "type": "string",
            "minLength": 1,
            "description": "Required in spirit for every MISSING: both searches that bound the claim."
          },
          "did_not_check": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The question's edges. Dropping these is how a bounded finding becomes an unbounded belief."
          }
        }
      },
      "description": "The archaeologist's findings kept whole rather than summarised. Three fields once survived here -- question, classification, ref -- and the commands, evidence, absence proofs and stated limits were discarded, so every planning session re-excavated what the last one had already established."
    },
    "sub_issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "gap",
          "accepted_outcome",
          "acceptance",
          "non_goals",
          "supersedes"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "gap": {
            "type": "string",
            "minLength": 1
          },
          "accepted_outcome": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^- \\*\\*AC-\\d+\\s*\\*\\* "
            }
          },
          "non_goals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "re_verified": {
            "type": "string",
            "pattern": "^[^:]+ \\d{4}-\\d{2}-\\d{2}$",
            "description": "Command then ISO date, no colon and no issue identifier. Optional in the body: a verification record is process rather than acceptance, and plan-lint reads the comment thread too. What belongs in the body is the conclusion -- which surfaces are involved -- because the grep that found them ages at the speed of the codebase, and whoever picks the work up re-derives it anyway."
          },
          "supersedes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "result",
        "unjudged",
        "known_limits"
      ],
      "properties": {
        "receipt": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,64}$"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "unjudged": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "known_limits": {
          "type": "array",
          "items": {
            "enum": [
              "L2-single-cycle",
              "L9-value-issue-has-no-file-surface"
            ]
          },
          "description": "Rules a plan of this shape cannot pass. Naming one here is the report; contorting the plan to pass it is not."
        }
      }
    }
  }
}
