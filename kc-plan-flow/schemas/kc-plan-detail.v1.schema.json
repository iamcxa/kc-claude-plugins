{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kc-plan-detail/v1",
  "title": "kc-plan-detail v1",
  "description": "How to build it. Sub-issues cut against archaeology findings, written in the form plan-lint reads, plus the lint result they were judged by.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "value_issue", "archaeology", "sub_issues", "lint"],
  "properties": {
    "schema": { "const": "kc-plan-detail/v1" },
    "value_issue": { "type": "string", "minLength": 1 },
    "archaeology": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "classification", "ref"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["WORKING", "WORKING_UNIT_UNPROVEN", "EXISTS_BROKEN", "STUB", "MISSING", "LOCATED"] },
          "ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sub_issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "gap", "accepted_outcome", "acceptance", "non_goals", "re_verified", "supersedes"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "gap": { "type": "string", "minLength": 1 },
          "accepted_outcome": { "type": "string", "minLength": 1 },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^- \\*\\*AC-\\d+\\s*\\*\\* " }
          },
          "non_goals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "re_verified": {
            "type": "string",
            "pattern": "^[^:]+ \\d{4}-\\d{2}-\\d{2}$",
            "description": "Command then ISO date. No colon anywhere: plan-lint splits the line on ':' and reads the last word as the date. No issue identifier either, because the tracker rewrites one into a link whose URL carries colons of its own."
          },
          "supersedes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "result", "unjudged", "known_limits"],
      "properties": {
        "receipt": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" },
        "result": { "enum": ["PASS", "FAIL"] },
        "unjudged": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "known_limits": {
          "type": "array",
          "items": { "enum": ["L2-single-cycle", "L9-value-issue-has-no-file-surface"] },
          "description": "Rules a plan of this shape cannot pass. Naming one here is the report; contorting the plan to pass it is not."
        }
      }
    }
  }
}
