{
	"$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noDoubleEquals": "off",
				"noVar": "off",
				"noRedundantUseStrict": "off",
				"noRedeclare": "off"
			},
			"style": {
				"useConst": "off",
				"useTemplate": "off"
			},
			"complexity": {
				"noForEach": "off",
				"useLiteralKeys": "off",
				"useArrowFunction": "off"
			},
			"correctness": {
				"noInnerDeclarations": "off",
				"noUnusedVariables": "warn"
			}
		}
	},
	"assist": {
		"enabled": false
	}
}
