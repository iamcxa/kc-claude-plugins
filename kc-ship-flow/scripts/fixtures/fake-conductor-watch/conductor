#!/usr/bin/env bash
# Stub `conductor` for watch.test.sh. No network, no real conductor binary required:
# --version/--help are synthesized here, covering exactly the argv shapes in
# kc-ship-flow/pins/conductor-cli.contract. Every invocation's argv is appended to
# $FAKE_CONDUCTOR_LOG when set.
#
# Env knobs:
#   FAKE_CONDUCTOR_VERSION        overrides the printed version (default 0.85.0); a version
#                                 bump alone must not trip the used-surface refusal.
#   FAKE_CONDUCTOR_DROP_SHAPE     omits one shape's line from --help (e.g. "workspace status").
#   FAKE_CONDUCTOR_TRANSCRIPTS    JSON file: {"<session-id>": "<transcript text>"}, read by
#                                 `sql` to answer a transcript-tail query for that session.
#   FAKE_CONDUCTOR_WORKSPACE_STATUS  JSON file: {"<workspace-id>": "<status>"}; a workspace
#                                 id absent from the map reports "running".
#   FAKE_CONDUCTOR_SESSION_STATUS   JSON file: {"<session-id>": "<status>"}; a session id
#                                 absent from the map reports "idle" (the prior fixed
#                                 behaviour), so existing callers that never set this still
#                                 see every session idle.
#   FAKE_CONDUCTOR_SQL_FAIL       when 1, `sql` prints the real Conductor 503 outage text
#                                 to stderr and exits non-zero (sql-503-degraded fixture).
#   FAKE_CONDUCTOR_SESSION_MESSAGES  JSON file: {"<session-id>": ["<msg 0 text>", ...]};
#                                 answers `session message <sid> --limit 1 --offset M`
#                                 with {"sessionIndex": M, "text": messages[M]} when
#                                 M < len(messages), else {} (no sessionIndex -- the
#                                 empty-tail signal the binary-search fallback stops on).
set -euo pipefail

[ -n "${FAKE_CONDUCTOR_LOG:-}" ] && printf '%s\n' "$*" >> "$FAKE_CONDUCTOR_LOG"

VERSION="${FAKE_CONDUCTOR_VERSION:-0.85.0}"
DROP="${FAKE_CONDUCTOR_DROP_SHAPE:-}"

print_help() {
  echo "conductor $VERSION"
  echo "conductor - manage cloud workspaces and coding agents (fake fixture)"
  echo
  echo "Authentication:"
  [ "$DROP" = "auth whoami" ] || echo "  conductor auth whoami               Show the configured token + base URL and verify against the API"
  echo
  echo "Project:"
  [ "$DROP" = "project list" ] || echo "  conductor project list [--limit <n>] [--offset <n>] [--json]"
  echo
  echo "Workspace:"
  [ "$DROP" = "workspace list" ] || echo "  conductor workspace list [--creator <userId>] [--limit <n>] [--offset <n>]"
  [ "$DROP" = "workspace create" ] || echo "  conductor workspace create [--project-id <id>] [--branch <name>] [--name <name>] [--agent <agent>] [--model <model>] [--effort <level>] [--env <KEY=VALUE>] [--message-file <path>] [--json]"
  [ "$DROP" = "workspace status" ] || echo "  conductor workspace status [workspaceId]"
  echo
  echo "Session:"
  [ "$DROP" = "session status" ] || echo "  conductor session status <sessionId>"
  [ "$DROP" = "session message" ] || echo "  conductor session message <sessionId> [--limit <n>] [--offset <n>]"
  echo
  echo "Other commands:"
  [ "$DROP" = "sql" ] || echo "  conductor sql <query>               Run a read-only SQL query over session_transcripts_view"
  echo
  echo "Global options:"
  echo "  --json                               Output JSON instead of human-readable tables (auth commands excepted)"
}

args=("$@")
if [ "${1:-}" = "--json" ]; then
  set -- "${@:2}"
fi

case "${1:-}" in
  --version) echo "$VERSION"; exit 0 ;;
  --help) print_help; exit 0 ;;
esac

if [ "${1:-}" = "auth" ] && [ "${2:-}" = "whoami" ]; then
  echo "User ID          usr-fixture-1"
  exit 0
fi

if [ "${1:-}" = "workspace" ] && [ "${2:-}" = "list" ]; then
  echo '{"data": [], "offset": 0, "hasMore": false}'
  exit 0
fi

if [ "${1:-}" = "workspace" ] && [ "${2:-}" = "status" ]; then
  workspace_id="${3:-}"
  python3 -c "
import json, sys
wid = sys.argv[1]
store_path = sys.argv[2]
try:
    store = json.load(open(store_path)) if store_path else {}
except OSError:
    store = {}
print(json.dumps({'status': store.get(wid, 'running')}))
" "$workspace_id" "${FAKE_CONDUCTOR_WORKSPACE_STATUS:-}"
  exit 0
fi

if [ "${1:-}" = "session" ] && [ "${2:-}" = "status" ]; then
  session_id="${3:-}"
  python3 -c "
import json, sys
sid = sys.argv[1]
store_path = sys.argv[2]
try:
    store = json.load(open(store_path)) if store_path else {}
except OSError:
    store = {}
print(json.dumps({'status': store.get(sid, 'idle')}))
" "$session_id" "${FAKE_CONDUCTOR_SESSION_STATUS:-}"
  exit 0
fi

if [ "${1:-}" = "session" ] && [ "${2:-}" = "message" ]; then
  session_id="${3:-}"
  shift 3 || true
  limit=1
  offset=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --limit) limit=$2; shift ;;
      --offset) offset=$2; shift ;;
    esac
    shift
  done
  python3 -c "
import json, sys
sid, offset, store_path = sys.argv[1], int(sys.argv[2]), sys.argv[3]
try:
    store = json.load(open(store_path)) if store_path else {}
except OSError:
    store = {}
messages = store.get(sid) or []
if offset < len(messages):
    print(json.dumps({'sessionIndex': offset, 'text': messages[offset]}))
else:
    print(json.dumps({}))
" "$session_id" "$offset" "${FAKE_CONDUCTOR_SESSION_MESSAGES:-}"
  exit 0
fi

if [ "${1:-}" = "sql" ]; then
  if [ "${FAKE_CONDUCTOR_SQL_FAIL:-0}" = 1 ]; then
    echo "The SQL search API endpoint is temporarily disabled (HTTP 503)" >&2
    exit 1
  fi
  query="${2:-}"
  session_id=$(printf '%s' "$query" | sed -nE "s/.*session_id = '([^']*)'.*/\1/p")
  python3 -c "
import json, sys
sid = sys.argv[1]
store_path = sys.argv[2]
try:
    store = json.load(open(store_path)) if store_path else {}
except OSError:
    store = {}
transcript = store.get(sid)
rows = [{'transcript': transcript}] if transcript is not None else []
print(json.dumps({'rows': rows, 'rowCount': len(rows), 'truncated': False}))
" "$session_id" "${FAKE_CONDUCTOR_TRANSCRIPTS:-}"
  exit 0
fi

echo "fake-conductor: unhandled ${args[*]}" >&2
exit 64
