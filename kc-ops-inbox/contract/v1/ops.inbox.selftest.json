{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iamcxa/kc-claude-plugins/blob/main/kc-ops-inbox/contract/v1/ops.inbox.selftest.json",
  "title": "Setup read-back self-test",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "dataschema",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "source": {
      "type": "string",
      "pattern": "^urn:[a-z0-9-]{1,32}(:[a-z0-9-]{1,32}){1,3}$"
    },
    "type": {
      "const": "ops.inbox.selftest"
    },
    "subject": {
      "type": "string",
      "pattern": "^selftest/[A-Za-z0-9._-]{1,64}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "enum": [
        "prod",
        "preview",
        "dev"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "dataschema": {
      "const": "https://github.com/iamcxa/kc-claude-plugins/blob/main/kc-ops-inbox/contract/v1/ops.inbox.selftest.json"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "data": {
      "type": "object",
      "required": [
        "v",
        "project"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "type": "integer",
          "minimum": 1
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
          "maxLength": 500
        }
      }
    }
  }
}
