{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iamcxa/kc-claude-plugins/blob/main/kc-ops-inbox/contract/v1/relay.capacity.ceiling.json",
  "title": "Relay capacity ceiling crossed",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "dataschema",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "type": {
      "const": "relay.capacity.ceiling"
    },
    "subject": {
      "type": "string",
      "pattern": "^ceiling/[a-z][a-z-]*/\\d{4}-\\d{2}-\\d{2}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "dataschema": {
      "const": "https://github.com/iamcxa/kc-claude-plugins/blob/main/kc-ops-inbox/contract/v1/relay.capacity.ceiling.json"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "data": {
      "type": "object",
      "required": [
        "v",
        "event",
        "at",
        "day",
        "count",
        "limit",
        "limitSource"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "type": "string",
          "maxLength": 500
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 500
        },
        "day": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 500
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "limitSource": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
