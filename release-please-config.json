{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "tag-separator": "-",
  "packages": {
    "e2e-pipeline": {
      "release-type": "simple",
      "component": "e2e-pipeline",
      "extra-files": [
        { "type": "json", "path": "e2e-pipeline/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "e2e-pipeline/.codex-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".claude-plugin/marketplace.json", "jsonpath": "$.plugins[?(@.name==\"e2e-pipeline\")].version" }
      ]
    },
    "kc-plugin-forge": {
      "release-type": "simple",
      "component": "kc-plugin-forge",
      "extra-files": [
        { "type": "json", "path": "kc-plugin-forge/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".claude-plugin/marketplace.json", "jsonpath": "$.plugins[?(@.name==\"kc-plugin-forge\")].version" }
      ]
    },
    "kc-nightwatch": {
