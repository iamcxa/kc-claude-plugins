      ]
    },
    "kc-hyperfocus": {
      "release-type": "simple",
      "component": "kc-hyperfocus",
      "extra-files": [
        { "type": "json", "path": "kc-hyperfocus/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".claude-plugin/marketplace.json", "jsonpath": "$.plugins[?(@.name==\"kc-hyperfocus\")].version" }
      ]
    },
    "kc-team-ops": {
      "release-type": "simple",
      "component": "kc-team-ops",
      "extra-files": [
        { "type": "json", "path": "kc-team-ops/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".claude-plugin/marketplace.json", "jsonpath": "$.plugins[?(@.name==\"kc-team-ops\")].version" }
      ]
    },
    "kc-pr-flow": {
      "release-type": "simple",
      "component": "kc-pr-flow",
      "extra-files": [
        { "type": "json", "path": "kc-pr-flow/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "kc-pr-flow/.codex-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".claude-plugin/marketplace.json", "jsonpath": "$.plugins[?(@.name==\"kc-pr-flow\")].version" }
      ]
    }
  }
}
