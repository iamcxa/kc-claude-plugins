#!/bin/sh
z=0000000000000000000000000000000000000000
rc=0
while read lref lsha rref rsha; do
  case "$rref" in refs/heads/spacedock-state/*) ;; *) continue;; esac
  [ "$lsha" = "$z" ] && continue
  if [ "$rsha" = "$z" ]; then range="$lsha"; else range="$rsha..$lsha"; fi
  for c in $(git rev-list "$range"); do
    git diff-tree -p -U0 --no-color --no-ext-diff --root "$c" > "/private/tmp/dev2/kc-claude-plugins-3042bb224e995ded/state-branch-writes-carry-no-private-identifiers/ideation-1/out/.push.diff"
    python3 -I - "/private/tmp/dev2/kc-claude-plugins-3042bb224e995ded/state-branch-writes-carry-no-private-identifiers/ideation-1/ids.tsv" "/private/tmp/dev2/kc-claude-plugins-3042bb224e995ded/state-branch-writes-carry-no-private-identifiers/ideation-1/out/.push.diff" "$c" <<'PY' || rc=1
import sys
exec(open("/private/tmp/dev2/kc-claude-plugins-3042bb224e995ded/state-branch-writes-carry-no-private-identifiers/ideation-1/proto/scan.py").read().split("def main")[0])
pats = load(sys.argv[1]); cur=None; hits=set()
for raw in open(sys.argv[2], encoding="utf-8", errors="replace"):
    raw = raw.rstrip("\n")
    if raw.startswith("+++ "): cur = raw[6:]
    elif raw.startswith("+") and cur:
        for k in classes(pats, raw[1:]): hits.add((cur, k))
for f, k in sorted(hits): print(f"state guard: push refused; commit {sys.argv[3][:9]} {f} adds a {k} identifier", file=sys.stderr)
sys.exit(1 if hits else 0)
PY
  done
done
exit $rc
