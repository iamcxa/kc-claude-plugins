+PROOF_COMMAND = re.compile(r"\bcommand\b|`[^`\n]+`", re.I)
+FALSIFIER_PART = re.compile(r"Falsifiers?\b:?.*?(?=Current evidence:|Evidence(?: command)?:|$)", re.S | re.I)
+UNPROVABLE_HEADING = re.compile(r"^[ \t]*#{2,4}[ \t]*Not provable now\b", re.I)
