+def proof_blocks(lines):
+    kept, inside = [], False
+    for line in lines:
+        if FENCE.match(line):
+            inside = not inside
+            kept.append(" ".join(m.group(0) for m in AC_DECLARATION.finditer(line)))
+        elif inside:
+            kept.append(" ".join(m.group(0) for m in AC_DECLARATION.finditer(line)))
+        else:
+            kept.append(line)
+    text = "\n".join(kept)
+    found = list(AC_DECLARATION.finditer(text))
+    blocks = {}
+    for index, declaration in enumerate(found):
+        tail = text[declaration.end():found[index + 1].start() if index + 1 < len(found) else len(text)]
+        tail = re.split(r"\n[ \t]*#{1,6}(?:[ \t]+|$)", tail, maxsplit=1)[0]
+        blocks[declaration.group(1)] = declaration.group(0) + tail
+    return blocks
+
