    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tldraw": "5.4.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
