+func TestKnowledgeMergeNativeArchive(t *testing.T) {
+	root, entity := knowledgeMergeFixture(t)
+	var out, errOut bytes.Buffer
+	code := MergeGuard([]string{"task", "--workflow-dir", root, "--delivery", "knowledge", "--verdict", "passed", "--json"}, root, &out, &errOut)
+	if doc, _, readErr := gates.Read(entity); readErr == nil {
+		t.Logf("active status=%s verdict=%s application=%s archive=%t", frontmatterField(t, entity, "status"), frontmatterField(t, entity, "verdict"), doc.Records[0].Attempts[0].Application.State, fileExists(filepath.Join(filepath.Dir(entity), "_archive", "task.md")))
+	}
+	if code != 0 || !strings.Contains(out.String(), `"signal":"finalized"`) {
+		t.Fatalf("knowledge finalize rc=%d out=%s err=%s", code, &out, &errOut)
+	}
+	archived := filepath.Join(filepath.Dir(entity), "_archive", "task.md")
+	if frontmatterField(t, archived, "verdict") != "PASSED" {
+		t.Fatal("knowledge not PASSED")
+	}
+	doc, _, err := gates.Read(archived)
+	if err != nil || doc.Records[0].Attempts[0].Application.State != "consumed" {
+		t.Fatalf("approval not consumed: %v", err)
+	}
+	if _, err := os.Stat(entity); !os.IsNotExist(err) {
+		t.Fatal("active task remains")
+	}
+}
