+func validateKnowledgeDelivery(entity, workflow string, snapshot []byte, binding Briefing) error {
+	root, _, _, err := frontmatterNode(snapshot)
+	if err != nil {
+		return err
+	}
+	field := func(key string) string {
+		if n := mappingValue(root, key); n != nil {
+			return strings.TrimSpace(n.Value)
+		}
+		return ""
+	}
+	if field("pr") != "" {
+		return fmt.Errorf("knowledge delivery refuses PR or merge claims")
+	}
+	manifest, err := boundBriefingManifest(entity, binding)
+	if err != nil {
+		return err
+	}
+	if len(manifest.Artifacts) != 1 {
+		return fmt.Errorf("knowledge delivery requires one approved declaration artifact")
+	}
+	roots := gitsource.Roots{Main: workflow, State: filepath.Dir(entity)}
+	artifact := manifest.Artifacts[0]
+	data, err := gitsource.Resolve(roots, artifact.URI, artifact.Rev)
+	if err != nil {
+		return err
+	}
+	const fence = "```spacedock-knowledge-delivery\n"
+	parts := strings.Split(string(data), fence)
+	if len(parts) != 2 {
+		return fmt.Errorf("approved artifact must contain one knowledge delivery declaration")
+	}
+	end := strings.Index(parts[1], "\n```")
+	if end < 0 {
+		return fmt.Errorf("unclosed knowledge delivery declaration")
+	}
+	if err := rejectDuplicateMembers([]byte(parts[1][:end])); err != nil {
+		return err
+	}
+	var declaration knowledgeDeclaration
+	decoder := json.NewDecoder(strings.NewReader(parts[1][:end]))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&declaration); err != nil {
+		return err
+	}
+	if declaration.Type != "KnowledgeDelivery" || declaration.Version != "1" || strings.TrimSpace(declaration.Outcome) == "" || len(declaration.Evidence) == 0 {
+		return fmt.Errorf("incomplete knowledge delivery declaration")
+	}
+	for _, evidence := range declaration.Evidence {
+		if _, err := gitsource.Resolve(roots, evidence.URI, evidence.Rev); err != nil {
+			return fmt.Errorf("knowledge evidence: %w", err)
+		}
+	}
+	gitRead := func(dir string, args ...string) (string, error) {
+		out, err := exec.Command("git", append([]string{"-C", dir}, args...)...).Output()
+		return strings.TrimSpace(string(out)), err
+	}
+	main, err := gitRead(workflow, "rev-parse", "--show-toplevel")
+	if err != nil {
+		return err
+	}
+	product := main
+	scope := "main"
+	if worktree := field("worktree"); worktree != "" {
+		if filepath.IsAbs(worktree) || filepath.Clean(worktree) == ".." || strings.HasPrefix(filepath.Clean(worktree), ".."+string(filepath.Separator)) {
+			return fmt.Errorf("knowledge product worktree must be repository-relative")
+		}
+		product = filepath.Join(main, worktree)
+		scope = "worktree"
+	}
+	if declaration.Product.Root != scope || declaration.Product.Worktree != field("worktree") {
+		return fmt.Errorf("knowledge product scope does not match the entity")
+	}
+	state, err := gitRead(filepath.Dir(entity), "rev-parse", "--show-toplevel")
+	productRoot, rootErr := gitRead(product, "rev-parse", "--show-toplevel")
+	if err != nil || rootErr != nil || productRoot == state {
+		return fmt.Errorf("knowledge delivery requires separate product and state Git roots")
+	}
+	fullCommit := regexp.MustCompile(`^[0-9a-f]{40}$`)
+	for _, commit := range []string{declaration.Product.Base, declaration.Product.Head} {
+		if !fullCommit.MatchString(commit) {
+			return fmt.Errorf("knowledge product requires full commit IDs")
+		}
+		resolved, err := gitRead(product, "rev-parse", "--verify", commit+"^{commit}")
+		if err != nil || resolved != commit {
+			return fmt.Errorf("knowledge product requires exact local commit objects")
+		}
+	}
+	readme, err := os.ReadFile(filepath.Join(workflow, "README.md"))
+	if err != nil {
+		return err
+	}
+	config, _, _, err := frontmatterNode(readme)
+	if err != nil {
+		return err
+	}
+	trunk := "main"
+	if value := mappingValue(config, "trunk"); value != nil && strings.TrimSpace(value.Value) != "" {
+		trunk = strings.TrimSpace(value.Value)
+	}
+	base, err := gitRead(product, "rev-parse", "--verify", "refs/heads/"+trunk+"^{commit}")
+	if err != nil || base != declaration.Product.Base {
+		return fmt.Errorf("knowledge product base does not match workflow trunk")
+	}
+	head, err := gitRead(product, "rev-parse", "HEAD")
+	if err != nil || head != declaration.Product.Head {
+		return fmt.Errorf("knowledge product HEAD changed")
+	}
+	if _, err := gitRead(product, "diff", "--exit-code", declaration.Product.Base, declaration.Product.Head, "--"); err != nil {
+		return fmt.Errorf("knowledge delivery has a product diff")
+	}
+	dirty, err := gitRead(product, "status", "--porcelain", "--untracked-files=all")
+	if err != nil || dirty != "" {
+		return fmt.Errorf("knowledge product checkout is not clean")
+	}
+	// The snapshot must still bind the gate record checked under this lock.
+	current, err := os.ReadFile(entity)
+	if err != nil || !bytes.Equal(current, snapshot) {
+		return fmt.Errorf("knowledge entity changed during evidence checks")
+	}
+	return nil
+}
