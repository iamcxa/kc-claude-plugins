+func TestKnowledgeApprovalRefusalsAndResume(t *testing.T) {
+	for _, kind := range []string{"valid", "attempt", "digest", "changed-worktree", "open-pr", "reason-sentinel", "briefing", "evidence", "product-claim", "missing-declaration", "duplicate-declaration", "missing-approval", "dirty-product", "product-diff", "changed-head", "substitution"} {
+		t.Run(kind, func(t *testing.T) {
+			root, entity := knowledgeApprovalFixture(t, kind)
+			binding := knowledgeBinding(t, entity)
+			switch kind {
+			case "attempt":
+				binding.Attempt += "changed"
+			case "digest":
+				binding.BriefingDigest += "changed"
+			case "changed-worktree":
+				data, _ := os.ReadFile(entity)
+				data = bytes.Replace(data, []byte("status: validation"), []byte("status: validation\nworktree: .worktrees/other"), 1)
+				os.WriteFile(entity, data, 0o644)
+			case "open-pr", "reason-sentinel":
+				value := "'#42'"
+				if kind == "reason-sentinel" {
+					value = "local-merge:knowledge"
+				}
+				data, _ := os.ReadFile(entity)
+				data = bytes.Replace(data, []byte("status: validation"), []byte("status: validation\npr: "+value), 1)
+				os.WriteFile(entity, data, 0o644)
+			case "briefing":
+				doc, _, _ := Read(entity)
+				room, _ := ResolveRoomRef(entity, doc.Records[0].Attempts[0].Briefing.RoomRef)
+				os.WriteFile(filepath.Join(room, "index.json"), []byte("{}"), 0o644)
+			case "dirty-product":
+				os.WriteFile(filepath.Join(root, "product.txt"), []byte("uncommitted product"), 0o644)
+			case "changed-head":
+				cmd := exec.Command("git", "-C", root, "commit", "--allow-empty", "-qm", "new product head")
+				if out, err := cmd.CombinedOutput(); err != nil {
+					t.Fatalf("%v %s", err, out)
+				}
+			case "substitution":
+				if _, err := SupersedeTerminalApproval(entity, root); err != nil {
+					t.Fatal(err)
+				}
+				if _, err := Prepare(entity, PrepareInput{WorkflowDir: root, Artifact: filepath.Join(filepath.Dir(entity), "knowledge.md"), Question: "Synthetic successor?", Summary: "TEST ONLY"}); err != nil {
+					t.Fatal(err)
+				}
+				if err := RecordSemantic(entity, RecordInput{WorkflowDir: root, Decision: "approve", Actor: "person:captain", Reason: "TEST ONLY successor"}); err != nil {
+					t.Fatal(err)
+				}
+			}
+			before, _ := os.ReadFile(entity)
+			target, err := FinalizeTerminalApproval(entity, root, "PASSED", "2026-09-11T00:00:00Z", binding)
+			after, _ := os.ReadFile(entity)
+			if kind != "valid" {
+				if err == nil || !bytes.Equal(before, after) {
+					t.Fatalf("%s must refuse unchanged: %v", kind, err)
+				}
+				return
+			}
+			if err != nil || target != "done" {
+				t.Fatalf("knowledge consume: %s %v", target, err)
+			}
+			if _, err := FinalizeTerminalApproval(entity, root, "PASSED", "changed", binding); err != nil {
+				t.Fatalf("resume: %v", err)
+			}
+			resumed, _ := os.ReadFile(entity)
+			if !bytes.Equal(after, resumed) {
+				t.Fatal("resume spent or wrote approval twice")
+			}
+			for _, tamper := range []struct{ old, new string }{{"verdict: PASSED", "verdict: REJECTED"}, {"decision: approve", "decision: reject"}} {
+				changed := bytes.Replace(after, []byte(tamper.old), []byte(tamper.new), 1)
+				os.WriteFile(entity, changed, 0o644)
+				if _, err := FinalizeTerminalApproval(entity, root, "PASSED", "changed", binding); err == nil {
+					t.Fatal("tampered consumed authority resumed")
+				}
+				readback, _ := os.ReadFile(entity)
+				if !bytes.Equal(changed, readback) {
+					t.Fatal("refused resume changed entity")
+				}
+			}
+			os.WriteFile(entity, after, 0o644)
+			doc, _, _ := Read(entity)
+			if doc.Records[0].Attempts[0].Application.State != "consumed" {
+				t.Fatal("approval not consumed")
+			}
+		})
+	}
+}
