
// Validation-only regression: a peer body edit between capture and locked finalize
// must survive a subsequent commit failure. Product candidate remains untouched.
func TestValidationKnowledgeRollbackPreservesPreLockPeerEdit(t *testing.T) {
 root, entity := knowledgeMergeFixture(t)
 state := filepath.Dir(entity)
 realGit, err := exec.LookPath("git"); if err != nil {t.Fatal(err)}
 bin := t.TempDir()
 marker := filepath.Join(bin, "injected")
 script := fmt.Sprintf("#!/bin/sh\ncase \"$*\" in\n *'ls-files -- :(literal)task')\n if [ ! -f '%s' ]; then\n printf '\\npeer edit before locked finalize\\n' >> '%s'\n touch '%s'\n fi;;\nesac\nexec '%s' \"$@\"\n", marker, entity, marker, realGit)
 if err := os.WriteFile(filepath.Join(bin,"git"), []byte(script),0755); err != nil {t.Fatal(err)}
 t.Setenv("PATH",bin+string(os.PathListSeparator)+os.Getenv("PATH"))
 if err := os.WriteFile(filepath.Join(state,".git","hooks","pre-commit"),[]byte(fmt.Sprintf("#!/bin/sh\ncp _archive/task.md %q\nexit 1\n", os.Getenv("VALIDATION_ARCHIVED_CAPTURE"))),0755); err != nil {t.Fatal(err)}
 var out, errOut bytes.Buffer
 code := MergeGuard([]string{"task","--workflow-dir",root,"--delivery","knowledge","--verdict","passed","--json"},root,&out,&errOut)
 if _,err:=os.Stat(marker);err!=nil {t.Fatalf("fixture did not inject: %v",err)}
 data, readErr := os.ReadFile(entity)
 if err := os.WriteFile(os.Getenv("VALIDATION_ROLLBACK_CAPTURE"),data,0600); err != nil {t.Fatal(err)}
 archived,_:=os.ReadFile(os.Getenv("VALIDATION_ARCHIVED_CAPTURE"))
 t.Logf("peer_edit_present_before_failed_commit=%t",bytes.Contains(archived,[]byte("peer edit before locked finalize")))
 t.Logf("rc=%d live=%t peer_edit_retained=%t stdout=%s stderr=%s",code,readErr==nil,bytes.Contains(data,[]byte("peer edit before locked finalize")),&out,&errOut)
 if code == 0 || readErr != nil || !bytes.Contains(data,[]byte("peer edit before locked finalize")) {t.Fatal("commit-failure rollback lost the peer edit captured by the locked consumer")}
}
